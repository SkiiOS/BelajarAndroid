<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="InputStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textColorHint">#777777</item>
    </style>

    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:backgroundTint">@null</item>  <!-- wajib -->
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:backgroundTint">@null</item>  <!-- wajib -->
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TertiaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="android:background">@drawable/btn_tersier</item>

        <item name="android:textColor">#000000</item>
        <item name="android:padding">14dp</item>
    </style>



    <style name="CalcButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_margin">8dp</item>

        <item name="android:background">@drawable/btn_secondary</item>
        <item name="backgroundTint">@null</item>

        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
